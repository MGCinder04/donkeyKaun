# Copy this file to .env for local dev. Never commit the real .env file (it's gitignored).
# On Render, set these under your Web Service's "Environment" tab instead — do not put
# real values in this file or anywhere else in the repo.

# Required in production and must be at least 12 characters. Leave unset locally only
# when deliberately testing without the gate.
SITE_PASSCODE=

# Required whenever SITE_PASSCODE is set (in production, always set both together).
# A long random string — e.g. generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional private Ustaad-assist unlock key. Use a unique random value of 24-64
# characters; never reuse SITE_PASSCODE. Keep the real value in Render only.
PRIVATE_USTAAD_SECRET=

# Required in production: the client's deployed URL (https://donkeykaunloader.onrender.com).
# Client and server are separate Render services, so the API needs to allow that origin
# for CORS and Socket.IO. Leave unset locally — the Vite dev proxy makes this a
# non-issue in dev.
CLIENT_ORIGIN=

# Optional durable room/game recovery. Set both only on the API service. The server
# stores SHA-256 membership-token hashes and game snapshots for 24 hours; it never
# stores raw room tokens, passcodes, TURN secrets, or voice media in Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ROOM_STATE_TTL_SECONDS=86400

# Optional but strongly recommended for reliable voice chat across mobile networks,
# VPNs, and restrictive routers. Create a TURN key in Cloudflare Realtime, then put
# its ID and permanent API token in Render only. Never expose either value to the client.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# Paid TURN is fail-closed even when the credentials above exist. Set this to true
# only after the passcode, origin, and billing safeguards have been verified.
TURN_ENABLED=false

# Hard application-side limits on fresh temporary credential issuance. Existing
# credentials expire after 30 minutes and cannot be renewed without live room access.
TURN_HOURLY_IP_LIMIT=30
TURN_DAILY_CREDENTIAL_LIMIT=120

PORT=3001
