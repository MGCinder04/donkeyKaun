# Copy to .env.local for local dev (usually unnecessary — the Vite dev proxy handles it).
# Never commit the real .env.local file.

# Required in production: the deployed API/server URL (e.g. https://donkey-kaun-api.onrender.com).
# Baked into the client build, so it must be set BEFORE running `npm run build`.
# Leave unset locally — Vite proxies /api and /socket.io to localhost:3001 instead.
VITE_API_URL=
