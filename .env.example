# Copy this file to .env for local dev. Never commit the real .env file (it's gitignored).
# On Render, set these under your Web Service's "Environment" tab instead — do not put
# real values in this file or anywhere else in the repo.

# Optional: if set, the whole site requires this passcode before it's reachable.
# Leave unset locally if you don't want the gate while developing.
SITE_PASSCODE=

# Required whenever SITE_PASSCODE is set (in production, always set both together).
# A long random string — e.g. generate one with: openssl rand -hex 32
SESSION_SECRET=

# Required in production: the client's deployed URL (e.g. https://donkey-kaun.onrender.com).
# Client and server are separate Render services, so the API needs to allow that origin
# for CORS and Socket.IO. Leave unset locally — the Vite dev proxy makes this a
# non-issue in dev.
CLIENT_ORIGIN=

# Optional but strongly recommended for reliable voice chat across mobile networks,
# VPNs, and restrictive routers. Create a TURN key in Cloudflare Realtime, then put
# its ID and permanent API token in Render only. Never expose either value to the client.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

PORT=3001
